    { "id": "fileInput-1", "type": "fileInput", "position": { "x": 40, "y": 360 },
      "data": { "id": "fileInput-1", "nodeType": "fileInput", "filename": "system.md", "content": "You are a precise technical writer. Write a tight 3-bullet brief grounded ONLY in the provided context. If the context is empty or irrelevant, say you don't have enough information." } },

    { "id": "text-1", "type": "text", "position": { "x": 380, "y": 40 },
      "data": { "id": "text-1", "nodeType": "text", "text": "Write a 3-bullet brief on {{topic}} using only the provided context." } },
    { "id": "knowledgeBase-1", "type": "knowledgeBase", "position": { "x": 380, "y": 300 },
      "data": { "id": "knowledgeBase-1", "nodeType": "knowledgeBase", "topK": 3,
        "documents": "Vector databases store high-dimensional embeddings for similarity search.\nCosine similarity ranks vectors by the angle between them.\nHNSW is a graph index that makes nearest-neighbor search fast.\nKeyword search matches exact words while semantic search matches meaning.\nEmbeddings turn text into numbers a model can compare.\nPinecone, Weaviate, and Qdrant are popular vector databases.\nTop K controls how many nearest matches a query returns.\nChunking splits long documents into pieces before embedding them.\nRAG retrieves relevant context and feeds it to an LLM.\nRecall measures how many of the relevant items a search actually finds." } },
    { "id": "vectorStore-1", "type": "vectorStore", "position": { "x": 380, "y": 720 },
      "data": { "id": "vectorStore-1", "nodeType": "vectorStore", "topK": 3,
        "documents": "Vector databases index embeddings so you can search by meaning, not keywords.\nAn embedding model maps text to a point in high-dimensional space.\nApproximate nearest-neighbour search keeps queries fast at scale.\nPinecone, Weaviate, Qdrant, and Milvus are popular vector stores.\nCosine similarity and dot product are common distance metrics.\nChunking and metadata filtering improve retrieval quality.\nHybrid search blends keyword and semantic ranking.\nRecall and latency are the usual trade-offs to tune." } },

    { "id": "filter-1", "type": "filter", "position": { "x": 720, "y": 760 },
      "data": { "id": "filter-1", "nodeType": "filter", "predicate": "len(item) > 10" } },
    { "id": "loop-1", "type": "loop", "position": { "x": 1060, "y": 700 },
      "data": { "id": "loop-1", "nodeType": "loop", "limit": 3 } },
    { "id": "merge-1", "type": "merge", "position": { "x": 1400, "y": 420 },
      "data": { "id": "merge-1", "nodeType": "merge" } },

    { "id": "llm-1", "type": "llm", "position": { "x": 1740, "y": 140 },
      "data": { "id": "llm-1", "nodeType": "llm", "provider": "groq", "model": "llama-3.3-70b-versatile", "temperature": "0.3", "apiKey": "" } },

    { "id": "condition-1", "type": "condition", "position": { "x": 2120, "y": 120 },
      "data": { "id": "condition-1", "nodeType": "condition", "test": "len(value) > 80" } },
    { "id": "transform-1", "type": "transform", "position": { "x": 2120, "y": 520 },
      "data": { "id": "transform-1", "nodeType": "transform", "expr": "len(value.split())" } },
    { "id": "display-1", "type": "display", "position": { "x": 2120, "y": 800 },
