# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Database name (optional, defaults to "vectorshift")
MONGO_DB=vectorshift

# Allowed CORS origins, comma-separated (optional, defaults to localhost:3000)
# CORS_ORIGINS=http://localhost:3000,https://your-deployed-frontend.com
